      {
        "name": "Calendário",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date"
          },
          {
            "name": "Ano",
            "dataType": "string",
            "sourceColumn": "Ano"
          },
          {
            "name": "MesNum",
            "dataType": "int64",
            "sourceColumn": "MesNum"
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes"
          },
          {
            "name": "Trimestre",
            "dataType": "string",
            "sourceColumn": "Trimestre"
          },
          {
            "name": "DiaSemana",
            "dataType": "string",
            "sourceColumn": "DiaSemana"
          },
          {
            "name": "Num Semana",
            "dataType": "int64",
            "sourceColumn": "Num Semana"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // ── 1. RECOLHER E CONVERTER DATAS ─────────────────────────",
                "    MinCompras2016 = Date.From(List.Min(RawCompras2016[DATA_COMPRA])),",
                "    MaxCompras2016 = Date.From(List.Max(RawCompras2016[DATA_COMPRA])),",
                "    MinCompras2017 = Date.From(List.Min(RawCompras2017[DATA_COMPRA])),",
                "    MaxCompras2017 = Date.From(List.Max(RawCompras2017[DATA_COMPRA])),",
                "    MinCompras2018 = Date.From(List.Min(RawCompras2018[DATA_COMPRA])),",
                "    MaxCompras2018 = Date.From(List.Max(RawCompras2018[DATA_COMPRA])),",
                "    MinConsumos2016 = Date.From(List.Min(RawConsumos2016[DATA_MOVIMENTO])),",
                "    MaxConsumos2016 = Date.From(List.Max(RawConsumos2016[DATA_MOVIMENTO])),",
                "    MinConsumos2017 = Date.From(List.Min(RawConsumos2017[DATA_MOVIMENTO])),",
                "    MaxConsumos2017 = Date.From(List.Max(RawConsumos2017[DATA_MOVIMENTO])),",
                "    MinConsumos2018 = Date.From(List.Min(RawConsumos2018[DATA_MOVIMENTO])),",
                "    MaxConsumos2018 = Date.From(List.Max(RawConsumos2018[DATA_MOVIMENTO])),",
                "",
                "    // ── 2. EXTREMO GLOBAL ─────────────────────────────────────",
                "    MinGlobal = List.Min({",
                "        MinCompras2016, MinCompras2017, MinCompras2018,",
                "        MinConsumos2016, MinConsumos2017, MinConsumos2018",
                "    }),",
                "    MaxGlobal = List.Max({",
                "        MaxCompras2016, MaxCompras2017, MaxCompras2018,",
                "        MaxConsumos2016, MaxConsumos2017, MaxConsumos2018",
                "    }),",
                "",
                "    // ── 3. GERAR CALENDÁRIO ───────────────────────────────────",
                "    TotalDias = Duration.Days(MaxGlobal - MinGlobal) + 1,",
                "    ListaDatas = List.Dates(MinGlobal, TotalDias, #duration(1,0,0,0)),",
                "    Tabela = Table.FromList(ListaDatas, Splitter.SplitByNothing(), {\"Date\"}, null, ExtraValues.Error),",
                "    TipoData = Table.TransformColumnTypes(Tabela, {{\"Date\", type date}}),",
                "",
                "    // ── 4. COLUNAS EXTRA ──────────────────────────────────────",
                "    AddAno = Table.AddColumn(TipoData, \"Ano\", ",
                "        each Text.From(Date.Year([Date])), type text),",
                "",
                "    AddTrimestre = Table.AddColumn(AddAno, \"Trimestre\", ",
                "        each \"T\" & Number.ToText(Date.QuarterOfYear([Date])), type text),",
                "",
                "    AddNumSemana = Table.AddColumn(AddTrimestre, \"Num Semana\", ",
                "        each Date.WeekOfYear([Date]), Int64.Type),",
                "",
                "    AddMesNum = Table.AddColumn(AddNumSemana, \"MesNum\", ",
                "        each Date.Month([Date]), Int64.Type),",
                "",
                "    AddMes = Table.AddColumn(AddMesNum, \"Mes\", ",
                "        each Date.ToText([Date], \"MMMM\", \"pt-PT\"), type text),",
                "",
                "    AddDiaSemana = Table.AddColumn(AddMes, \"DiaSemana\", ",
                "        each Date.ToText([Date], \"dddd\", \"pt-PT\"), type text)",
                "",
                "in",
                "    AddDiaSemana"
              ]
            }
          }
        ]
      },
