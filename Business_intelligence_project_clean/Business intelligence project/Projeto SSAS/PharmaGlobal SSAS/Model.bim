          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/localhost\\MECDBI2026;PharmaGlobalDWH\",",
                "    dbo_RawFornecedores = Source{[Schema=\"dbo\",Item=\"RawFornecedores\"]}[Data],",
                "",
                "    // Tratar Nulls",
                "    TratarPortes = Table.ReplaceValue(dbo_RawFornecedores, null, 0, Replacer.ReplaceValue, {\"PORTES\"}),",
                "    TratarAvaliacao = Table.ReplaceValue(TratarPortes, null, 0, Replacer.ReplaceValue, {\"AVALIACAO\"}),",
                "    TratarDataInativacao = Table.ReplaceValue(TratarAvaliacao, null, \"Ativo\", Replacer.ReplaceValue, {\"DATA_INATIVACAO\"})",
                "",
                "in",
                "    TratarDataInativacao"
              ]
            }
          }
        ]
